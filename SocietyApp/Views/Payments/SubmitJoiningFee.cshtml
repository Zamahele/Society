@model SocietyApp.ViewModels.SubmitJoiningFeeViewModel
@{
    ViewData["Title"] = "Submit Joining Fee";
    var isStaffSubmit = ViewBag.IsStaffSubmit as bool? ?? false;
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-3">Submit Joining Fee Payment</h2>
        @if (isStaffSubmit)
        {
            <div class="alert alert-warning">
                You are submitting this joining fee <strong>on behalf of</strong> member <strong>@Model.MembershipNumber</strong>.
            </div>
        }
        <div class="alert alert-info">
            Please pay <strong>R150</strong> via EFT to the society's bank account using <strong>@Model.MembershipNumber</strong> as the payment reference, then fill in the details below.
        </div>
        <form asp-action="SubmitJoiningFee" method="post">
            <input type="hidden" asp-for="MembershipId" />
            <input type="hidden" asp-for="MembershipNumber" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="PaymentReference" class="form-label"></label>
                <input asp-for="PaymentReference" class="form-control" />
                <span asp-validation-for="PaymentReference" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PaymentDate" class="form-label"></label>
                <input asp-for="PaymentDate" class="form-control" type="date" />
                <span asp-validation-for="PaymentDate" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-dark">Submit</button>
            @if (isStaffSubmit)
            {
                <a asp-controller="Admin" asp-action="MemberDetails" asp-route-id="@Model.MembershipId" class="btn btn-outline-secondary ms-2">Cancel</a>
            }
            else
            {
                <a asp-controller="Members" asp-action="Dashboard" class="btn btn-outline-secondary ms-2">Cancel</a>
            }
        </form>
    </div>
</div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
