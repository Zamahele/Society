@model IList<SocietyApp.Models.ApplicationUser>
@{ ViewData["Title"] = "Clerk Accounts"; }

<div class="page-shell">
<div class="page-header">
    <div><p class="dashboard-eyebrow">Team access</p><h1>Clerk accounts</h1><p>Manage staff access to daily operations.</p></div>
    <a asp-action="CreateClerk" class="btn btn-primary"><i class="bi bi-person-plus" aria-hidden="true"></i> Add clerk</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state"><i class="bi bi-person-badge" aria-hidden="true"></i><strong>No clerk accounts found.</strong><span>Add a clerk to share operational responsibilities.</span></div>
}
else
{
    <div class="table-shell">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0 data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>ID Number</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var clerk in Model)
                    {
                        bool isLocked = clerk.LockoutEnd.HasValue && clerk.LockoutEnd > DateTimeOffset.UtcNow;
                        <tr>
                            <td><strong>@clerk.FullName</strong></td>
                            <td>@clerk.IDNumber</td>
                            <td>@(clerk.Email ?? "-")</td>
                            <td>
                                @if (isLocked)
                                {
                                    <span class="badge status-badge bg-danger">Deactivated</span>
                                }
                                else
                                {
                                    <span class="badge status-badge bg-success">Active</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (isLocked)
                                {
                                    <form asp-action="ActivateClerk" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@clerk.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="DeactivateClerk" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@clerk.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-warning"
                                                data-confirm="Deactivate @clerk.FullName? They will not be able to log in.">
                                            Deactivate
                                        </button>
                                    </form>
                                }
                                <form asp-action="DeleteClerk" method="post" class="d-inline ms-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@clerk.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            data-confirm="Permanently delete @clerk.FullName's account? This cannot be undone.">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
</div>
