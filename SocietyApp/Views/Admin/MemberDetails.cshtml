@model SocietyApp.Models.Membership
@{
    ViewData["Title"] = "Member Details";
    var joiningFees = (IEnumerable<SocietyApp.Models.JoiningFeePayment>)(ViewBag.JoiningFeePayments
        ?? new List<SocietyApp.Models.JoiningFeePayment>());
    var hasPendingJoiningFee = ViewBag.HasPendingJoiningFee as bool? ?? false;
    var canApprove = Model.Status == SocietyApp.Models.MembershipStatus.Pending
                   && hasPendingJoiningFee;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@Model.User.FullName — @Model.MembershipNumber</h2>
    <a asp-action="Members" class="btn btn-outline-secondary">Back</a>
</div>

<div class="card border-warning mb-4">
    <div class="card-header bg-warning-subtle">Admin Actions</div>
    <div class="card-body d-flex flex-wrap gap-2">
        @if (canApprove)
        {
            <form asp-action="ApproveMember" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-success"
                        data-confirm="Approve @Model.User.FullName and confirm their R150 joining fee payment?">
                    Approve Member
                </button>
            </form>
        }
        else if (Model.Status == SocietyApp.Models.MembershipStatus.Pending)
        {
            <button class="btn btn-outline-primary" type="button"
                    data-bs-toggle="collapse" data-bs-target="#submitJoiningFeeForm">
                Submit Joining Fee on behalf
            </button>
            <span class="text-muted align-self-center small fst-italic">No joining fee on record yet.</span>
        }

        @if (Model.Status == SocietyApp.Models.MembershipStatus.Suspended)
        {
            <form asp-action="ReactivateMember" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-success">Reactivate Member</button>
            </form>
        }
        else if (Model.Status == SocietyApp.Models.MembershipStatus.Active)
        {
            <form asp-action="DeactivateMember" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-danger">Deactivate Member</button>
            </form>
        }

        @if (Model.Status != SocietyApp.Models.MembershipStatus.Cancelled)
        {
            <form asp-action="CancelMembership" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-dark"
                        data-confirm="Cancel this membership permanently? This cannot be undone.">Cancel Membership</button>
            </form>
        }

        <a asp-action="AddDependantForMember" asp-route-membershipId="@Model.Id" class="btn btn-dark">Add Dependant</a>

        <form asp-action="DeleteMemberData" method="post" class="row row-cols-lg-auto g-2 align-items-center ms-lg-2">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="col-12">
                <label for="confirmIdNumber" class="form-label mb-0 small">Type member ID number to permanently delete all records:</label>
            </div>
            <div class="col-12">
                <input id="confirmIdNumber" name="confirmIdNumber" class="form-control" placeholder="@Model.User.IDNumber" required />
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-danger" data-confirm="This will permanently delete this member and all related records. This cannot be undone.">Delete Member Data</button>
            </div>
        </form>
    </div>
</div>

@if (Model.Status == SocietyApp.Models.MembershipStatus.Pending && !hasPendingJoiningFee)
{
    <div class="collapse mb-4" id="submitJoiningFeeForm">
        <div class="card border-primary">
            <div class="card-header bg-primary text-white">Submit Joining Fee on behalf of @Model.User.FullName</div>
            <div class="card-body">
                <div class="alert alert-info py-2 px-3 small mb-3">
                    R150 via EFT to Capitec acc <strong>1054981680</strong> (Give Compassion NPC), branch 450105, using <strong>@Model.MembershipNumber</strong> as reference.
                </div>
                <form asp-controller="Payments" asp-action="SubmitPayment" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="MembershipId" value="@Model.Id" />
                    <input type="hidden" name="MembershipNumber" value="@Model.MembershipNumber" />
                    <input type="hidden" name="PaymentType" value="JoiningFee" />
                    <div class="row g-2">
                        <div class="col-sm-6">
                            <label class="form-label form-label-sm">EFT Reference</label>
                            <input name="PaymentReference" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label form-label-sm">
                                <i class="bi bi-camera"></i> Proof of Payment <span class="text-muted">(optional)</span>
                            </label>
                            <input name="Proof" id="jfProofInput" type="file" class="form-control form-control-sm"
                                   accept="image/*,.pdf" capture="environment" />
                            <small class="text-muted">Take a photo or upload a bank screenshot / PDF.</small>
                            <div id="jfProofPreview" class="mt-2" style="display:none;">
                                <img id="jfProofPreviewImg" src="" class="img-fluid rounded" style="max-height:140px;" alt="Preview" />
                            </div>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-sm btn-dark">Submit</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    data-bs-toggle="collapse" data-bs-target="#submitJoiningFeeForm">Cancel</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<div class="row">
    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                Member Info
                <button class="btn btn-sm btn-outline-light" type="button"
                        data-bs-toggle="collapse" data-bs-target="#editProfileForm">Edit</button>
            </div>
            <div class="collapse" id="editProfileForm">
                <div class="card-body border-bottom">
                    <form asp-action="EditMemberProfile" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="membershipId" value="@Model.Id" />
                        <div class="mb-2">
                            <label class="form-label small fw-semibold">Full Name</label>
                            <input name="fullName" class="form-control form-control-sm" value="@Model.User.FullName" required />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold">Phone</label>
                            <input name="phone" class="form-control form-control-sm" value="@Model.User.Phone" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold">Address</label>
                            <input name="address" class="form-control form-control-sm" value="@Model.User.Address" />
                        </div>
                        <button type="submit" class="btn btn-sm btn-dark">Save</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                data-bs-toggle="collapse" data-bs-target="#editProfileForm">Cancel</button>
                    </form>
                </div>
            </div>
            <div class="card-body">
                <p><strong>ID Number:</strong> @Model.User.IDNumber</p>
                <p><strong>Phone:</strong> @Model.User.Phone</p>
                <p><strong>Address:</strong> @Model.User.Address</p>
                <p><strong>Bank:</strong> @Model.User.BankName</p>
                <p><strong>Account:</strong> @Model.User.BankAccountNumber (@Model.User.BankAccountName)</p>
                <p>
                    <strong>Status:</strong>
                    @{
                        var statusBadge = Model.Status switch
                        {
                            SocietyApp.Models.MembershipStatus.Active => "bg-success",
                            SocietyApp.Models.MembershipStatus.Pending => "bg-warning text-dark",
                            SocietyApp.Models.MembershipStatus.Suspended => "bg-danger",
                            SocietyApp.Models.MembershipStatus.Cancelled => "bg-dark",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @statusBadge">@Model.Status</span>
                </p>
                <p><strong>Joined:</strong> @Model.DateIssued.ToString("dd MMM yyyy")</p>
                @if (Model.DateActivated.HasValue)
                {
                    <p><strong>Activated:</strong> @Model.DateActivated.Value.ToString("dd MMM yyyy")</p>
                }
                @if (Model.Status == SocietyApp.Models.MembershipStatus.Active && Model.DateActivated.HasValue)
                {
                    var elapsed = ViewBag.WaitingMonthsElapsed as int? ?? 0;
                    var eligibility = ViewBag.Eligibility as SocietyApp.Services.Interfaces.ClaimEligibilityResult;
                    <div class="mt-3">
                        @if (eligibility?.IsEligible == true)
                        {
                            <span class="badge bg-success">Eligible to claim</span>
                        }
                        else
                        {
                            <div class="small text-muted mb-1">Waiting period: @elapsed / 6 months</div>
                            <div class="progress" style="height:6px;">
                                <div class="progress-bar bg-info" role="progressbar"
                                     style="width:@(elapsed * 100 / 6)%"></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-dark text-white">Nominee</div>
            <div class="card-body">
                @if (Model.Nominee == null)
                {
                    <p class="text-muted small mb-0">No nominee on record.</p>
                }
                else
                {
                    <p class="mb-1"><strong>Name:</strong> @Model.Nominee.FullName</p>
                    <p class="mb-1"><strong>ID Number:</strong> @Model.Nominee.IDNumber</p>
                    <p class="mb-1"><strong>Phone:</strong> @Model.Nominee.Phone</p>
                    <p class="mb-0"><strong>Relationship:</strong> @Model.Nominee.Relationship</p>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-dark text-white">Dependants (@Model.Dependants.Count)</div>
            <ul class="list-group list-group-flush">
                @foreach (var d in Model.Dependants)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@d.FullName <span class="text-muted small">(@d.Relationship)</span></span>
                        <div class="d-flex gap-1">
                            <a asp-action="EditDependantForMember"
                               asp-route-dependantId="@d.Id" asp-route-membershipId="@Model.Id"
                               class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="RemoveDependantForMember" method="post"
                                  data-confirm="Remove this dependant? This cannot be undone.">
                                <input type="hidden" name="membershipId" value="@Model.Id" />
                                <input type="hidden" name="dependantId" value="@d.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>

    <div class="col-md-8">
        @if (joiningFees.Any())
        {
            <div class="card mb-4">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <span>Joining Fee Review</span>
                    @if (canApprove)
                    {
                        <form asp-action="ApproveMember" method="post" class="m-0">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-sm btn-success"
                                    data-confirm="Approve @Model.User.FullName and confirm their R150 joining fee payment?">
                                Approve &amp; Confirm
                            </button>
                        </form>
                    }
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>Amount</th>
                                <th>Reference</th>
                                <th>Paid On</th>
                                <th>Status</th>
                                <th>Proof</th>
                                <th>Confirmed</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var jf in joiningFees)
                            {
                                var isPdf = jf.ProofFileName?.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) == true;
                                var jfBadge = jf.Status == SocietyApp.Models.PaymentStatus.Confirmed ? "bg-success" : "bg-warning text-dark";
                                <tr>
                                    <td>R@(jf.Amount)</td>
                                    <td>@jf.PaymentReference</td>
                                    <td>@jf.PaymentDate.ToString("dd MMM yyyy")</td>
                                    <td><span class="badge @jfBadge">@jf.Status</span></td>
                                    <td>
                                        @if (jf.ProofData != null)
                                        {
                                            if (isPdf)
                                            {
                                                <a asp-controller="Payments" asp-action="JoiningFeeProof" asp-route-id="@jf.Id"
                                                   target="_blank" class="btn btn-sm btn-outline-secondary">
                                                    <i class="bi bi-file-earmark-pdf"></i> PDF
                                                </a>
                                            }
                                            else
                                            {
                                                <img src="@Url.Action("JoiningFeeProof", "Payments", new { id = jf.Id })"
                                                     class="proof-thumb rounded"
                                                     style="height:56px;width:72px;object-fit:cover;cursor:pointer;"
                                                     data-full="@Url.Action("JoiningFeeProof", "Payments", new { id = jf.Id })"
                                                     data-label="@Model.User.FullName — @jf.PaymentDate.ToString("dd MMM yyyy")"
                                                     alt="Proof" />
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">None</span>
                                        }
                                    </td>
                                    <td class="small text-muted">
                                        @(jf.ConfirmedDate.HasValue ? jf.ConfirmedDate.Value.ToString("dd MMM yyyy") : "-")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Proof lightbox modal (joining fee) -->
            <div class="modal fade" id="jfProofModal" tabindex="-1">
                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header py-2">
                            <h6 class="modal-title" id="jfProofModalLabel">Proof of Payment</h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body p-1 text-center">
                            <img id="jfProofModalImg" src="" class="img-fluid rounded" alt="Proof" style="max-height:80vh;" />
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="card mb-4">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <span>Monthly Payment History</span>
                @if (Model.Status == SocietyApp.Models.MembershipStatus.Active)
                {
                    <button class="btn btn-sm btn-outline-light" type="button"
                            data-bs-toggle="collapse" data-bs-target="#submitMonthlyForm">
                        + Submit Monthly Payment
                    </button>
                }
            </div>
            @if (Model.Status == SocietyApp.Models.MembershipStatus.Active)
            {
                <div class="collapse" id="submitMonthlyForm">
                    <div class="card-body border-bottom">
                        <div class="alert alert-info py-2 px-3 small mb-3">
                            R150 via EFT to Capitec acc <strong>1054981680</strong> (Give Compassion NPC), branch 450105, using <strong>@Model.MembershipNumber</strong> as reference.
                        </div>
                        <form asp-controller="Payments" asp-action="SubmitPayment" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="MembershipId" value="@Model.Id" />
                            <input type="hidden" name="MembershipNumber" value="@Model.MembershipNumber" />
                            <input type="hidden" name="PaymentType" value="Monthly" />
                            <div class="row g-2">
                                <div class="col-sm-4">
                                    <label class="form-label form-label-sm">For Month</label>
                                    <input name="ForMonth" type="date" class="form-control form-control-sm"
                                           value="@(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).ToString("yyyy-MM-dd"))" required />
                                </div>
                                <div class="col-sm-4">
                                    <label class="form-label form-label-sm">EFT Reference</label>
                                    <input name="PaymentReference" class="form-control form-control-sm" required />
                                </div>
                                <div class="col-sm-4">
                                    <label class="form-label form-label-sm">
                                        <i class="bi bi-camera"></i> Proof of Payment <span class="text-muted">(optional)</span>
                                    </label>
                                    <input name="Proof" id="mpProofInput" type="file" class="form-control form-control-sm"
                                           accept="image/*,.pdf" capture="environment" />
                                    <small class="text-muted">Photo or PDF.</small>
                                    <div id="mpProofPreview" class="mt-2" style="display:none;">
                                        <img id="mpProofPreviewImg" src="" class="img-fluid rounded" style="max-height:140px;" alt="Preview" />
                                    </div>
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn btn-sm btn-dark">Submit</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            data-bs-toggle="collapse" data-bs-target="#submitMonthlyForm">Cancel</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            }
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead><tr><th>Month</th><th>Reference</th><th>Status</th><th>Confirmed By</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var p in (IEnumerable<SocietyApp.Models.MonthlyPayment>)ViewBag.MonthlyHistory)
                        {
                            <tr>
                                <td>@p.ForMonth.ToString("MMM yyyy")</td>
                                <td>@p.PaymentReference</td>
                                <td><span class="badge @(p.Status == SocietyApp.Models.MonthlyPaymentStatus.Confirmed ? "bg-success" : p.Status == SocietyApp.Models.MonthlyPaymentStatus.Missed ? "bg-danger" : "bg-warning text-dark")">@p.Status</span></td>
                                <td>@(p.ConfirmedByClerk?.FullName ?? "-")</td>
                                <td>
                                    @if (p.Status == SocietyApp.Models.MonthlyPaymentStatus.Pending)
                                    {
                                        <form asp-action="DeleteMonthlyPayment" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <input type="hidden" name="returnTo" value="MemberDetails" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                                    data-confirm="Delete this pending payment? This cannot be undone.">
                                                Delete
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                Reset Password
                <button class="btn btn-sm btn-outline-light" type="button"
                        data-bs-toggle="collapse" data-bs-target="#resetPasswordForm">Reset</button>
            </div>
            <div class="collapse" id="resetPasswordForm">
                <div class="card-body">
                    <p class="text-muted small mb-3">Set a new temporary password for this member. They should change it after logging in.</p>
                    <form asp-action="ResetMemberPassword" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@Model.UserId" />
                        <input type="hidden" name="membershipId" value="@Model.Id" />
                        <div class="row g-2">
                            <div class="col-sm-6">
                                <input name="newPassword" type="password" class="form-control form-control-sm"
                                       placeholder="New password (min 8 chars)" required minlength="8" />
                            </div>
                            <div class="col-sm-3">
                                <button type="submit" class="btn btn-sm btn-dark w-100">Set Password</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-dark text-white">Claims</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead><tr><th>Deceased</th><th>Date</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var c in (IEnumerable<SocietyApp.Models.DeathClaim>)ViewBag.Claims)
                        {
                            <tr>
                                <td>@c.DeceasedFullName</td>
                                <td>@c.ClaimDate.ToString("dd MMM yyyy")</td>
                                <td><span class="badge bg-secondary">@c.ClaimStatus</span></td>
                                <td><a asp-controller="Claims" asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-dark">View</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.proof-thumb').forEach(function (img) {
            img.addEventListener('click', function () {
                document.getElementById('jfProofModalImg').src = this.dataset.full;
                document.getElementById('jfProofModalLabel').textContent = this.dataset.label;
                new bootstrap.Modal(document.getElementById('jfProofModal')).show();
            });
        });

        function wireProofPreview(inputId, previewId, imgId) {
            var input = document.getElementById(inputId);
            if (!input) return;
            input.addEventListener('change', function () {
                var file = this.files[0];
                var preview = document.getElementById(previewId);
                var img = document.getElementById(imgId);
                if (file && file.type.startsWith('image/')) {
                    var reader = new FileReader();
                    reader.onload = function (e) { img.src = e.target.result; preview.style.display = ''; };
                    reader.readAsDataURL(file);
                } else {
                    img.src = '';
                    preview.style.display = 'none';
                }
            });
        }
        wireProofPreview('jfProofInput', 'jfProofPreview', 'jfProofPreviewImg');
        wireProofPreview('mpProofInput', 'mpProofPreview', 'mpProofPreviewImg');
    </script>
}
