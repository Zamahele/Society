@model IEnumerable<SocietyApp.Models.Membership>
@{ ViewData["Title"] = "All Members"; }

<div class="page-shell">
<div class="page-header">
    <div>
        <p class="dashboard-eyebrow">Membership registry</p>
        <h1>All members</h1>
        <p>Review member status, dependants, and registration details.</p>
    </div>
    <div class="page-header-actions">
        <span class="page-count">@Model.Count() members</span>
        <a asp-action="CreateMember" class="btn btn-primary"><i class="bi bi-person-plus" aria-hidden="true"></i> Create member</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state"><i class="bi bi-people" aria-hidden="true"></i><strong>No members registered yet.</strong><span>New member applications will appear here.</span></div>
}
else
{
    <!-- Desktop table (md+) -->
    <div class="d-none d-md-block">
        <div class="table-shell">
        <table class="table table-hover align-middle data-table">
            <thead>
                <tr><th>Membership No</th><th>Name</th><th>ID Number</th><th>Phone</th><th>Dependants</th><th>Status</th><th>Joined</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    var badge = m.Status switch
                        {
                            SocietyApp.Models.MembershipStatus.Active => "bg-success",
                            SocietyApp.Models.MembershipStatus.Pending => "bg-warning text-dark",
                            SocietyApp.Models.MembershipStatus.Suspended => "bg-danger",
                            SocietyApp.Models.MembershipStatus.Cancelled => "bg-dark",
                            _ => "bg-secondary"
                        };
                    <tr>
                        <td><strong>@m.MembershipNumber</strong></td>
                        <td>@m.User.FullName</td>
                        <td>@m.User.IDNumber</td>
                        <td>@m.User.Phone</td>
                        <td>@m.Dependants.Count</td>
                        <td><span class="badge status-badge @badge">@m.Status</span></td>
                        <td>@m.DateIssued.ToString("dd MMM yyyy")</td>
                        <td>
                            <a asp-controller="Members" asp-action="Dashboard" asp-route-id="@m.Id" class="btn btn-sm btn-outline-dark">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>

    <!-- Mobile cards (< md) -->
    <div class="d-md-none row g-3">
        @foreach (var m in Model)
        {
            var mbadge = m.Status switch
                {
                    SocietyApp.Models.MembershipStatus.Active => "bg-success",
                    SocietyApp.Models.MembershipStatus.Pending => "bg-warning text-dark",
                    SocietyApp.Models.MembershipStatus.Suspended => "bg-danger",
                    SocietyApp.Models.MembershipStatus.Cancelled => "bg-dark",
                    _ => "bg-secondary"
                };
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="fw-bold mb-1">@m.User.FullName</h6>
                                <small class="text-muted">@m.MembershipNumber</small>
                            </div>
                            <span class="badge status-badge @mbadge">@m.Status</span>
                        </div>
                        <hr class="my-2">
                        <div class="row small">
                            <div class="col-6"><strong>ID:</strong> @m.User.IDNumber</div>
                            <div class="col-6"><strong>Phone:</strong> @m.User.Phone</div>
                            <div class="col-6"><strong>Dependants:</strong> @m.Dependants.Count</div>
                            <div class="col-6"><strong>Joined:</strong> @m.DateIssued.ToString("dd MMM yyyy")</div>
                        </div>
                        <div class="mt-3">
                            <a asp-controller="Members" asp-action="Dashboard" asp-route-id="@m.Id" class="btn btn-sm btn-outline-dark">View</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
</div>
