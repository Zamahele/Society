@model SocietyApp.ViewModels.PublicLandingViewModel
@{
    ViewData["Title"] = "Welcome";
    Layout = "_LayoutLanding";
    var settings = Model.Settings;
    var phone1 = string.IsNullOrWhiteSpace(settings.ContactPhone1) ? "Not provided" : settings.ContactPhone1;
    var phone2 = string.IsNullOrWhiteSpace(settings.ContactPhone2) ? "Not provided" : settings.ContactPhone2;
    var phone3 = string.IsNullOrWhiteSpace(settings.ContactPhone3) ? "Not provided" : settings.ContactPhone3;
    var address = string.IsNullOrWhiteSpace(settings.ContactAddress) ? "Not provided" : settings.ContactAddress;
    var email = string.IsNullOrWhiteSpace(settings.ContactEmailInfo) ? "Not provided" : settings.ContactEmailInfo;
}

<main class="home-page">
    <section class="home-hero">
        <div class="home-hero-copy">
            <p class="home-kicker">Funeral benefit society</p>
            <h1>@settings.OrganizationName</h1>
            <p class="home-lead">Practical support for families when it matters most, with affordable contributions and dependable benefits.</p>
            <div class="home-actions">
                <a asp-controller="Account" asp-action="Register" class="btn btn-home-primary">Join the society</a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-home-secondary">Member login</a>
            </div>
        </div>
        <div class="home-hero-proof">
            <div><strong>R15,000</strong><span>Cash payout</span></div>
            <div><strong>R15,000</strong><span>Grocery voucher</span></div>
            <div><strong>R150</strong><span>Monthly contribution</span></div>
        </div>
    </section>

    <section class="home-board" aria-label="Society information">
        <div class="home-board-main">
            <div class="home-panel home-process-panel">
                <div class="home-panel-heading"><span class="home-label">Your membership</span><h2>Simple support, from joining to claiming</h2></div>
                <div class="home-process-grid">
                    <article><span>01</span><h3>Register online</h3><p>Create your account with your ID number and personal details.</p></article>
                    <article><span>02</span><h3>Pay once</h3><p>Pay the R150 joining fee to activate your membership.</p></article>
                    <article><span>03</span><h3>Stay active</h3><p>Keep your cover active with a R150 monthly contribution.</p></article>
                    <article><span>04</span><h3>Claim when needed</h3><p>Submit a claim after the six-month waiting period.</p></article>
                </div>
            </div>

            <div class="home-panel home-benefits-panel">
                <div class="home-panel-heading"><span class="home-label">What is covered</span><h2>Benefits built for difficult days</h2></div>
                <div class="home-benefit-grid">
                    <article><i class="bi bi-cash-stack" aria-hidden="true"></i><div><h3>Cash payout</h3><strong>R15,000</strong><p>Direct support for funeral and related costs.</p></div></article>
                    <article><i class="bi bi-basket2" aria-hidden="true"></i><div><h3>Grocery voucher</h3><strong>R15,000</strong><p>Help with food for family and guests.</p></div></article>
                    <article><i class="bi bi-people" aria-hidden="true"></i><div><h3>Dependants</h3><strong>Up to 10</strong><p>Cover spouse, children, and extended family.</p></div></article>
                </div>
                <div class="home-notices"><span><strong>Waiting:</strong> 6 months from activation</span><span><strong>Grace:</strong> 30 days overdue before suspension</span></div>
            </div>
        </div>

        <aside class="home-board-side">
            <div class="home-panel home-bank-panel">
                <div class="home-panel-heading"><span class="home-label">Payment details</span><h2>Pay by EFT</h2></div>
                <dl class="home-details">
                    <div><dt>Bank</dt><dd>@settings.BankName</dd></div>
                    <div><dt>Account name</dt><dd>@settings.BankAccountName</dd></div>
                    <div><dt>Account number</dt><dd>@settings.BankAccountNumber</dd></div>
                    <div><dt>Branch code</dt><dd>@settings.BankBranchCode</dd></div>
                    <div><dt>Reference</dt><dd>Your membership number</dd></div>
                </dl>
                <p class="home-callout"><i class="bi bi-info-circle" aria-hidden="true"></i> Always use your membership number as payment reference.</p>
            </div>

            <div class="home-panel home-fees-panel">
                <div class="home-panel-heading"><span class="home-label">Contribution</span><h2>Membership fees</h2></div>
                <div class="home-fee-row"><span>Joining fee</span><strong>R150 once-off</strong></div>
                <div class="home-fee-row"><span>Monthly contribution</span><strong>R150 / month</strong></div>
            </div>
        </aside>
    </section>

    <section class="home-footer-board">
        <div class="home-committee">
            <div><span class="home-label">Your people</span><h2>Committee</h2></div>
            <div class="home-committee-list">
                @if (Model.CommitteeMembers.Any())
                {
                    foreach (var member in Model.CommitteeMembers)
                    {
                        var initial = string.IsNullOrWhiteSpace(member.FullName) ? "?" : member.FullName.Trim()[0].ToString().ToUpperInvariant();
                        <div class="home-person"><span>@initial</span><div><strong>@member.FullName</strong><small>@member.RoleTitle · @member.Phone</small></div></div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">Committee details will appear here.</p>
                }
            </div>
        </div>
        <div class="home-contact">
            <div><span class="home-label">Need help?</span><h2>Contact us</h2></div>
            <p><i class="bi bi-geo-alt" aria-hidden="true"></i>@address</p>
            <p><i class="bi bi-telephone" aria-hidden="true"></i>@phone1 · @phone2 · @phone3</p>
            <p><i class="bi bi-envelope" aria-hidden="true"></i>@email</p>
        </div>
    </section>
</main>
