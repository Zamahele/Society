@model SocietyApp.Models.Organization
@using SocietyApp.Models
@{ ViewData["Title"] = "Organization Members"; var members = (IEnumerable<OrganizationMember>)ViewBag.Members; }

<div class="page-shell">
<div class="page-header">
    <div>
        <p class="dashboard-eyebrow">Organization account</p>
        <h1>@Model.Name</h1>
        <p>Registration number: @Model.RegistrationNumber</p>
    </div>
    <a asp-action="AddMember" class="btn btn-primary"><i class="bi bi-person-plus" aria-hidden="true"></i> Add member</a>
</div>

<div class="page-panel">
    <div class="page-panel-heading"><h3>People under this organization</h3><span class="page-count">@members.Count() members</span></div>
    <div class="page-panel-body">
        @if (!members.Any())
        {
            <div class="empty-state"><i class="bi bi-people" aria-hidden="true"></i><strong>No members have been added yet.</strong><span>Add people to start managing this organization.</span></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle data-table">
                    <thead><tr><th>Name</th><th>ID Number</th><th>Phone</th><th>Date of Birth</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var member in members)
                    {
                        <tr>
                            <td>@member.FullName</td>
                            <td>@member.IDNumber</td>
                            <td>@member.Phone</td>
                            <td>@member.DateOfBirth.ToString("dd MMM yyyy")</td>
                            <td><span class="badge bg-warning text-dark">@member.Status</span></td>
                            <td class="text-end">
                                <form asp-action="RemoveMember" method="post">
                                    <input type="hidden" name="id" value="@member.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
</div>