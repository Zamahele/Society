@model IEnumerable<SocietyApp.Models.MemberDependant>
@{ ViewData["Title"] = "Dependants"; }

<div class="page-shell">
<div class="page-header">
    <div><p class="dashboard-eyebrow">Member portal</p><h1>My dependants</h1><p>Manage the people covered under your membership.</p></div>
    @if ((bool)ViewBag.CanAdd)
    {
        <a asp-action="AddDependant" class="btn btn-primary"><i class="bi bi-person-plus" aria-hidden="true"></i> Add dependant</a>
    }
    else
    {
        <span class="text-muted">Maximum of 10 dependants reached</span>
    }
</div>

@if (!Model.Any())
{
    <div class="empty-state"><i class="bi bi-people" aria-hidden="true"></i><strong>No dependants registered yet.</strong><span>Add a dependant to your membership.</span></div>
}
else
{
    <div class="table-shell">
    <table class="table table-hover data-table">
        <thead>
            <tr><th>Name</th><th>ID Number</th><th>Date of Birth</th><th>Relationship</th><th>Date Added</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td>@d.FullName</td>
                    <td>@d.IDNumber</td>
                    <td>@d.DateOfBirth.ToString("dd MMM yyyy")</td>
                    <td>@d.Relationship</td>
                    <td>@d.DateAdded.ToString("dd MMM yyyy")</td>
                    <td>
                        <form asp-action="RemoveDependant" method="post" data-confirm="Remove this dependant? This cannot be undone.">
                            <input type="hidden" name="id" value="@d.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove @d.FullName">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
</div>
