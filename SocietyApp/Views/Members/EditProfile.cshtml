@model SocietyApp.ViewModels.EditProfileViewModel
@{ ViewData["Title"] = "Edit Profile"; }

<div class="page-shell">
    <div class="form-shell">
        <div class="d-flex align-items-center mb-3 gap-3">
            <a asp-action="Dashboard" class="btn btn-outline-secondary">&larr; Back</a>
        </div>
        <p class="dashboard-eyebrow">Member portal</p>
        <h1>Edit profile</h1>
        <form asp-action="EditProfile" method="post" class="form-section">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label fw-semibold"></label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Address" class="form-label fw-semibold"></label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-dark">Save Changes</button>
                    <a asp-action="Dashboard" class="btn btn-outline-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
