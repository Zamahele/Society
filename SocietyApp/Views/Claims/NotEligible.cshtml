@{ ViewData["Title"] = "Not Eligible"; }

<div class="page-shell">
    <div class="form-shell">
        <p class="dashboard-eyebrow">Member services</p>
        <div class="alert alert-danger mt-3">
            <h2 class="h4">Claim not available yet</h2>
            <ul class="mb-0 mt-2">
                @foreach (var reason in (List<string>)ViewBag.Reasons)
                {
                    <li>@reason</li>
                }
            </ul>
        </div>
        <a asp-controller="Members" asp-action="Dashboard" class="btn btn-dark">Back to Dashboard</a>
    </div>
</div>
